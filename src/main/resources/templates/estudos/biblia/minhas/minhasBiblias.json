					"citacoes": [
						{
							"citacao": "A numeração de capítulos e versículos seguem a NV, sendo indicadas em subscrito itálico as numerações divergentes encontradas em outras edições.",
							"referencia": "p. XI"
						},
						{
							"citacao": "Os Salmos são numerados conforme as atuais edições do texto hebraico e a Nova Vulgata, trazendo entre ( ) a numeração litúrgica (= antiga Vulgata).",
							"referencia": "p. XI"
						}
