							"citacao": "antiga tradução \"Vulgata\": Biblia Sacra iuxta Vulgatam Versionem (Stuttgart 1983)",
							"referencia": "p. X"
						}
					],
					"citacoes": [
						{
							"grupo": "Numeração",
							"citacao": "A numeração de capítulos e versículos seguem a NV, sendo indicadas em subscrito itálico as numerações divergentes encontradas em outras edições.",
							"referencia": "p. XI"
						},
						{
							"grupo": "Numeração",
							"citacao": "Os Salmos são numerados conforme as atuais edições do texto hebraico e a Nova Vulgata, trazendo entre ( ) a numeração litúrgica (= antiga Vulgata).",
							"referencia": "p. XI"
						},
						{
							"grupo": "Tradução",
							"citacao": "A presente tradução foi, de fato, traduzida destes idiomas originais.",
							"referencia": "p. 6"
						},
						{
							"grupo": "Tradução",
							"citacao": "A Nova Vulgata [...] serviu de modelo da presente tradução [...]",
							"referencia": "p. 8"
						}
					]
