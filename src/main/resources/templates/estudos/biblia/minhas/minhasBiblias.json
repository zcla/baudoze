							"referencia": "p. X"
						},
						{
							"codigo": "NV",
							"citacao": "nova tradução latina: Nova Vulgata Bibliorum Sacrorum Editio (2ª ed. típica, 1986)",
							"referencia": "p. X"
						},
						{
